{
  "manifest_version": 2,
  "name": "Lyrics Displayer Milestone 1",
  "version": "0.1.0",
  "description": "Sends synthetic playback snapshots to Lyrics Displayer.",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "applications": {
    "gecko": {
      "id": "lyrics-displayer@example.com"
    }
  }
}

