{
  "manifest_version": 2,
  "name": "Lyrics Displayer Milestone 4",
  "version": "0.4.0",
  "description": "Sends authoritative YouTube Music playback snapshots to Lyrics Displayer.",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "scripts": [
      "lyrics-coordinator.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "lyrics-api.js",
        "lyrics-content.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lyrics-displayer@example.com"
    }
  }
}
