<Window x:Class="LyricsDisplayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricsDisplayer"
        Title="Lyrics Displayer" Height="760" Width="900"
        MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Topmost="False" ShowInTaskbar="True" ShowActivated="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding EffectiveTitle}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding EffectiveArtist}" FontSize="13" Foreground="#FF6B7280"
                           Visibility="{Binding HasEffectiveArtist, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="Open Built-in Editor" Command="{Binding OpenBuiltInEditorCommand}"
                        Padding="12,7" Margin="0,0,8,0" />
                <Button Content="Show Desktop Lyrics" Click="OnShowDesktopLyrics"
                        Padding="12,7" Margin="0,0,8,0" />
                <Button Content="Open LRC Externally" IsEnabled="{Binding CanOpenExternalLyrics}"
                        ToolTip="{Binding ExternalLyricsStatus}"
                        Click="OnOpenLrcExternally" Padding="12,7" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1" Background="#FFFAFAFB">
            <ListBox x:Name="LyricsListBox" ItemsSource="{Binding Lines}"
                     Background="Transparent" BorderThickness="0"
                     PreviewMouseWheel="OnLyricsPreviewMouseWheel"
                     PreviewKeyDown="OnLyricsPreviewKeyDown"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MainLyricsLineViewModel}">
                        <Border Padding="12,7" Margin="8,2" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static local:LyricLineRole.Current}">
                                            <Setter Property="Background" Value="#FFEAF1F7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Text}" MinHeight="22"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Stretch">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="22" />
                                        <Setter Property="Foreground" Value="#FF30343B" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="{x:Static local:LyricLineRole.Past}">
                                                <Setter Property="Foreground" Value="#FF777D86" />
                                                <Setter Property="Opacity" Value="0.82" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Role}" Value="{x:Static local:LyricLineRole.Current}">
                                                <Setter Property="FontSize" Value="25" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding EmptyStateMessage}"
                       Visibility="{Binding HasNoLines, Converter={StaticResource BooleanToVisibilityConverter}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" Foreground="#FF6B7280" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="40" />
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
            <TextBlock Text="{Binding LyricsStatusText}" DockPanel.Dock="Right"
                       Foreground="#FF6B7280" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBlock Text="{Binding ConnectionStatus}" Foreground="#FF6B7280"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
