<Window x:Class="LyricsDisplayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrics Displayer - Diagnostics" Height="850" Width="980"
        MinHeight="600" MinWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="260" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Transport" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="Pipe Connection Status" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PipeStatusText" Text="Starting" />
            <TextBlock Grid.Row="2" Text="Source Session ID" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SessionIdText" Text="-" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Text="Sequence" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SequenceText" Text="-" />
            <TextBlock Grid.Row="4" Text="Last Message Time" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LastMessageText" Text="-" />

            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Track" FontSize="18" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBlock Grid.Row="6" Text="Track ID" />
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TrackIdText" Text="-" />
            <TextBlock Grid.Row="7" Text="Title" />
            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TitleText" Text="-" />
            <TextBlock Grid.Row="8" Text="Artist" />
            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ArtistText" Text="-" />
            <TextBlock Grid.Row="9" Text="Album" />
            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="AlbumText" Text="-" />
            <TextBlock Grid.Row="10" Text="Duration" />
            <TextBlock Grid.Row="10" Grid.Column="1" x:Name="DurationText" Text="-" />

            <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="Playback and lyrics" FontSize="18" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBlock Grid.Row="12" Text="Snapshot Position" />
            <TextBlock Grid.Row="12" Grid.Column="1" x:Name="SnapshotPositionText" Text="-" />
            <TextBlock Grid.Row="13" Text="Local Playback Position" />
            <TextBlock Grid.Row="13" Grid.Column="1" x:Name="LocalPositionText" Text="-" />
            <TextBlock Grid.Row="14" Text="Playing" />
            <TextBlock Grid.Row="14" Grid.Column="1" x:Name="PlayingText" Text="-" />
            <TextBlock Grid.Row="15" Text="Playback Rate" />
            <TextBlock Grid.Row="15" Grid.Column="1" x:Name="PlaybackRateText" Text="-" />
            <TextBlock Grid.Row="16" Text="Lyrics Available" />
            <TextBlock Grid.Row="16" Grid.Column="1" x:Name="LyricsAvailableText" Text="-" />
            <TextBlock Grid.Row="17" Text="Lyrics Timed" />
            <TextBlock Grid.Row="17" Grid.Column="1" x:Name="LyricsTimedText" Text="-" />
            <TextBlock Grid.Row="18" Text="Lyrics Source / Lines" />
            <StackPanel Grid.Row="18" Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LyricsSourceText" Text="-" />
                    <TextBlock Text=" / " />
                    <TextBlock x:Name="LyricsCountText" Text="0" />
                </StackPanel>
                <TextBlock x:Name="LyricsAttributionText" Text="-" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="19" Grid.ColumnSpan="2" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Current Lyric Index" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentLyricIndexText" Text="None" />
                <TextBlock Grid.Row="1" Text="Current Lyric Start" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CurrentLyricStartText" Text="-" />
                <TextBlock Grid.Row="2" Text="Current Lyric Text" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CurrentLyricText" Text="-" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Next Lyric Index" Margin="0,6,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="NextLyricIndexText" Text="None" Margin="0,6,0,0" />
                <TextBlock Grid.Row="4" Text="Next Lyric Start" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="NextLyricStartText" Text="-" />
                <TextBlock Grid.Row="5" Text="Next Lyric Text" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="NextLyricText" Text="-" TextWrapping="Wrap" />
            </Grid>
            <TextBox Grid.Row="20" Grid.ColumnSpan="2" x:Name="LyricsLinesText" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" TextWrapping="NoWrap" />
            <TextBlock Grid.Row="21" Grid.ColumnSpan="2" Text="Local lyrics library" FontSize="18" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBox Grid.Row="22" Grid.ColumnSpan="2" x:Name="LibraryDiagnosticsText" IsReadOnly="True"
                     MinHeight="240" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            <TextBlock Grid.Row="23" Grid.ColumnSpan="2" Text="Raw JSON" FontSize="18" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBox Grid.Row="24" Grid.ColumnSpan="2" x:Name="RawJsonText" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Window>
