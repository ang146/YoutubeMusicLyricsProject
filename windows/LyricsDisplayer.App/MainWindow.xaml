<Window x:Class="LyricsDisplayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="clr-namespace:LyricsDisplayer.Views.Main"
        xmlns:strings="clr-namespace:LyricsDisplayer.Resources"
        Title="{x:Static strings:Strings.MainWindowTitle}" Height="760" Width="900"
        MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Topmost="False" ShowInTaskbar="True" ShowActivated="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <main:MainHeaderView Grid.Row="0" ShowDesktopLyricsRequested="OnShowDesktopLyricsRequested" />
        <main:MainLyricsView Grid.Row="1" x:Name="MainLyricsReader" />
        <main:MainStatusBarView Grid.Row="2" />
    </Grid>
</Window>
