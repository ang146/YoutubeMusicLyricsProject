<Window x:Class="LyricsDisplayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrics Displayer Control Panel" Height="850" Width="980"
        MinHeight="600" MinWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="260" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <CheckBox x:Name="ShowOverlayCheckBox" DockPanel.Dock="Right"
                          Content="Show Desktop Lyrics" VerticalAlignment="Center" />
                <TextBlock Text="Transport" FontSize="18" FontWeight="Bold" />
            </DockPanel>
            <TextBlock Grid.Row="1" Text="Pipe Connection Status" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PipeStatusText" Text="Starting" />
            <TextBlock Grid.Row="2" Text="Source Session ID" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SessionIdText" Text="-" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Text="Sequence" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SequenceText" Text="-" />
            <TextBlock Grid.Row="4" Text="Last Message Time" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LastMessageText" Text="-" />

            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Track" FontSize="18" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBlock Grid.Row="6" Text="Track ID" />
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TrackIdText" Text="-" />
            <TextBlock Grid.Row="7" Text="Title" />
            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TitleText" Text="-" />
            <TextBlock Grid.Row="8" Text="Artist" />
            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ArtistText" Text="-" />
            <TextBlock Grid.Row="9" Text="Album" />
            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="AlbumText" Text="-" />
            <TextBlock Grid.Row="10" Text="Duration" />
            <TextBlock Grid.Row="10" Grid.Column="1" x:Name="DurationText" Text="-" />

            <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="Playback and lyrics" FontSize="18" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBlock Grid.Row="12" Text="Snapshot Position" />
            <TextBlock Grid.Row="12" Grid.Column="1" x:Name="SnapshotPositionText" Text="-" />
            <TextBlock Grid.Row="13" Text="Local Playback Position" />
            <TextBlock Grid.Row="13" Grid.Column="1" x:Name="LocalPositionText" Text="-" />
            <TextBlock Grid.Row="14" Text="Playing" />
            <TextBlock Grid.Row="14" Grid.Column="1" x:Name="PlayingText" Text="-" />
            <TextBlock Grid.Row="15" Text="Playback Rate" />
            <TextBlock Grid.Row="15" Grid.Column="1" x:Name="PlaybackRateText" Text="-" />
            <TextBlock Grid.Row="16" Text="Lyrics Available" />
            <TextBlock Grid.Row="16" Grid.Column="1" x:Name="LyricsAvailableText" Text="-" />
            <TextBlock Grid.Row="17" Text="Lyrics Timed" />
            <TextBlock Grid.Row="17" Grid.Column="1" x:Name="LyricsTimedText" Text="-" />
            <TextBlock Grid.Row="18" Text="Lyrics Source / Lines" />
            <StackPanel Grid.Row="18" Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LyricsSourceText" Text="-" />
                    <TextBlock Text=" / " />
                    <TextBlock x:Name="LyricsCountText" Text="0" />
                </StackPanel>
                <TextBlock x:Name="LyricsAttributionText" Text="-" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="19" Grid.ColumnSpan="2" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Current Lyric Index" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentLyricIndexText" Text="None" />
                <TextBlock Grid.Row="1" Text="Current Lyric Start" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CurrentLyricStartText" Text="-" />
                <TextBlock Grid.Row="2" Text="Current Lyric Text" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CurrentLyricText" Text="-" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Next Lyric Index" Margin="0,6,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="NextLyricIndexText" Text="None" Margin="0,6,0,0" />
                <TextBlock Grid.Row="4" Text="Next Lyric Start" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="NextLyricStartText" Text="-" />
                <TextBlock Grid.Row="5" Text="Next Lyric Text" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="NextLyricText" Text="-" TextWrapping="Wrap" />
            </Grid>
            <Border Grid.Row="20" Grid.ColumnSpan="2" BorderBrush="#FFD0D0D0" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,8,0,8">
                <StackPanel>
                    <TextBlock Text="Timing Adjustment" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Global Timing" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="TimingMinus500Button" Content="-0.5s" Padding="10,4" Margin="0,0,6,0" />
                        <Button x:Name="TimingMinus100Button" Content="-0.1s" Padding="10,4" Margin="0,0,12,0" />
                        <TextBlock x:Name="TimingOffsetText" Text="0.000s" FontFamily="Consolas"
                                   FontSize="16" FontWeight="SemiBold" Width="90" VerticalAlignment="Center"
                                   TextAlignment="Center" />
                        <Button x:Name="TimingResetButton" Content="Reset" Padding="10,4" Margin="6,0,12,0" />
                        <Button x:Name="TimingPlus100Button" Content="+0.1s" Padding="10,4" Margin="0,0,6,0" />
                        <Button x:Name="TimingPlus500Button" Content="+0.5s" Padding="10,4" Margin="0,0,12,0" />
                        <Button x:Name="TimingBakeButton" Content="Bake into LRC" Padding="10,4" />
                    </WrapPanel>
                    <TextBlock x:Name="TimingStatusText" Foreground="#FF9C1C1C" Margin="0,7,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Current Line — edits the selected timestamp directly in LRC"
                               FontWeight="SemiBold" Margin="0,12,0,6" />
                    <TextBlock x:Name="CurrentLineTimingText" Text="No current local lyric"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button x:Name="CurrentLineMinus500Button" Content="-0.5s" Padding="10,4" Margin="0,0,6,0" />
                        <Button x:Name="CurrentLineMinus100Button" Content="-0.1s" Padding="10,4" Margin="0,0,18,0" />
                        <Button x:Name="CurrentLinePlus100Button" Content="+0.1s" Padding="10,4" Margin="0,0,6,0" />
                        <Button x:Name="CurrentLinePlus500Button" Content="+0.5s" Padding="10,4" />
                    </WrapPanel>
                    <TextBlock x:Name="CurrentLineTimingStatusText" Foreground="#FF9C1C1C"
                               TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="21" Grid.ColumnSpan="2" BorderBrush="#FFD0D0D0" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,8,0,8">
                <StackPanel>
                    <TextBlock Text="Overlay Preferences" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="OverlayLockedCheckBox" Content="Lock position" Margin="0,0,18,0" />
                        <CheckBox x:Name="OverlayClickThroughCheckBox" Content="Click through" Margin="0,0,18,0" />
                        <CheckBox x:Name="OverlayTopmostCheckBox" Content="Always on top" />
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="Display" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="OverlayContentModeComboBox" Width="130" Margin="0,0,18,0">
                            <ComboBoxItem Content="One line" />
                            <ComboBoxItem Content="Two lines" />
                            <ComboBoxItem Content="All lyrics" />
                        </ComboBox>
                        <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="OverlayWidthTextBox" Width="80" VerticalContentAlignment="Center" />
                        <Button x:Name="OverlayWidthApplyButton" Content="Apply" Padding="10,3" Margin="6,0,0,0" />
                    </WrapPanel>
                    <TextBlock x:Name="OverlayPreferenceStatusText" Foreground="#FF9C1C1C"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="Global shortcuts: Ctrl+Alt+Shift+L toggles the overlay; Ctrl+Alt+Shift+T toggles click-through."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="HotkeyStatusText" Foreground="#FF9C1C1C" TextWrapping="Wrap" />
                    <CheckBox x:Name="CloseControlPanelToTrayCheckBox"
                              Content="Close Control Panel to system tray instead of exiting" Margin="0,8,0,0" />
                    <TextBlock x:Name="ApplicationPreferenceStatusText" Foreground="#FF9C1C1C"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBox Grid.Row="22" Grid.ColumnSpan="2" x:Name="LyricsLinesText" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" TextWrapping="NoWrap" />
            <TextBlock Grid.Row="23" Grid.ColumnSpan="2" Text="Local lyrics library" FontSize="18" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBox Grid.Row="24" Grid.ColumnSpan="2" x:Name="LibraryDiagnosticsText" IsReadOnly="True"
                     MinHeight="240" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            <TextBlock Grid.Row="25" Grid.ColumnSpan="2" Text="Raw JSON" FontSize="18" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBox Grid.Row="26" Grid.ColumnSpan="2" x:Name="RawJsonText" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Window>
