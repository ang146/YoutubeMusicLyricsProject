<Window x:Class="LyricsDisplayer.BuiltInLyricsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Built-in Lyrics Editor" Width="1080" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="EditorWarningCellBackground" Color="#FFFFE3A3" />
        <SolidColorBrush x:Key="EditorWarningCellForeground" Color="#FF593800" />
        <SolidColorBrush x:Key="EditorErrorCellBackground" Color="#FFFFC7C7" />
        <SolidColorBrush x:Key="EditorErrorCellForeground" Color="#FF650000" />
        <Style x:Key="EditorDiagnosticCellBaseStyle" TargetType="{x:Type DataGridCell}"
               BasedOn="{StaticResource {x:Type DataGridCell}}" />
        <Style x:Key="EditorRowHeaderStyle" TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ContextMenu" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="6,0,6,0" />
        </Style>
        <DataTemplate x:Key="EditorRowHeaderTemplate">
            <TextBlock Text="{Binding}" TextAlignment="Right"
                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </DataTemplate>
        <Style x:Key="EditorValidationSummaryStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="ToolTip" Value="{Binding ValidationSummaryToolTip}" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Source title" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceTitle}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Source artist" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SourceArtist}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Title override" VerticalAlignment="Center" Margin="0,6,0,0" />
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,12,0">
                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearTitleOverrideCommand}" Margin="6,0,0,0" />
                <TextBox Text="{Binding TitleOverride, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Artist override" VerticalAlignment="Center" Margin="0,6,0,0" />
            <DockPanel Grid.Row="1" Grid.Column="3" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearArtistOverrideCommand}" Margin="6,0,0,0" />
                <TextBox Text="{Binding ArtistOverride, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding PlaybackLiveText}" FontFamily="Consolas" FontSize="15"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="Set Time" Command="{Binding SetTimestampFromPlaybackCommand}"
                    Padding="10,5" />
        </Grid>

        <GroupBox Grid.Row="2" Header="Timing Authoring" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Shift All Timestamps" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="-0.5s" Command="{Binding ShiftAllTimestampsCommand}"
                                CommandParameter="-500" Padding="8,4" Margin="0,0,5,0" />
                        <Button Content="-0.1s" Command="{Binding ShiftAllTimestampsCommand}"
                                CommandParameter="-100" Padding="8,4" Margin="0,0,5,0" />
                        <Button Content="+0.1s" Command="{Binding ShiftAllTimestampsCommand}"
                                CommandParameter="100" Padding="8,4" Margin="0,0,5,0" />
                        <Button Content="+0.5s" Command="{Binding ShiftAllTimestampsCommand}"
                                CommandParameter="500" Padding="8,4" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Selected Line" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="-0.5s" Command="{Binding ShiftSelectedLineTimingCommand}"
                                CommandParameter="-500" Padding="8,4" Margin="0,0,5,0" />
                        <Button Content="-0.1s" Command="{Binding ShiftSelectedLineTimingCommand}"
                                CommandParameter="-100" Padding="8,4" Margin="0,0,5,0" />
                        <Button Content="+0.1s" Command="{Binding ShiftSelectedLineTimingCommand}"
                                CommandParameter="100" Padding="8,4" Margin="0,0,5,0" />
                        <Button Content="+0.5s" Command="{Binding ShiftSelectedLineTimingCommand}"
                                CommandParameter="500" Padding="8,4" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Button Content="Undo" Command="{Binding UndoCommand}" Padding="9,4" Margin="0,0,6,0" />
            <Button Content="Redo" Command="{Binding RedoCommand}" Padding="9,4" Margin="0,0,14,0" />
            <Button Content="Insert Above" Command="{Binding InsertRowAboveCommand}" Padding="9,4" Margin="0,0,6,0" />
            <Button Content="Insert Below" Command="{Binding InsertRowBelowCommand}" Padding="9,4" Margin="0,0,6,0" />
            <Button Content="Append Row" Command="{Binding AppendRowCommand}" Padding="9,4" Margin="0,0,6,0" />
            <Button Content="Delete Row" Command="{Binding DeleteRowCommand}" Padding="9,4" />
        </WrapPanel>

        <TextBlock Grid.Row="4" Text="{Binding ExternalConflict}" Foreground="#FF9C1C1C"
                   TextWrapping="Wrap" Margin="0,0,0,6" />

        <DataGrid x:Name="LyricsGrid" Grid.Row="5" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="Cell"
                  HeadersVisibility="All" RowHeaderWidth="48"
                  RowHeaderStyle="{StaticResource EditorRowHeaderStyle}"
                  RowHeaderTemplate="{StaticResource EditorRowHeaderTemplate}"
                  LoadingRow="OnGridLoadingRow" PreviewMouseDown="OnGridPreviewMouseDown"
                  GridLinesVisibility="All"
                  CellEditEnding="OnCellEditEnding" SelectedCellsChanged="OnSelectedCellsChanged"
                  CurrentCellChanged="OnCurrentCellChanged" PreviewKeyDown="OnGridPreviewKeyDown"
                  BeginningEdit="OnBeginningEdit">
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Set Time" Command="{Binding SetTimestampFromPlaybackCommand}" />
                    <Separator />
                    <MenuItem Header="Insert Row Above" Command="{Binding InsertRowAboveCommand}" />
                    <MenuItem Header="Insert Row Below" Command="{Binding InsertRowBelowCommand}" />
                    <MenuItem Header="Append Row" Command="{Binding AppendRowCommand}" />
                    <MenuItem Header="Delete Row" Command="{Binding DeleteRowCommand}" />
                    <Separator />
                    <MenuItem Header="Undo" Command="{Binding UndoCommand}" />
                    <MenuItem Header="Redo" Command="{Binding RedoCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <DockPanel Grid.Row="6" Margin="0,8,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Preserved entries: " VerticalAlignment="Center" />
                <TextBlock Text="{Binding PreservedEntries.Count}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="#FF9C1C1C" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Grid.Row="7">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" Padding="18,6" Margin="0,0,8,0" />
                <Button Content="Close" Click="OnCloseClick" Padding="18,6" IsCancel="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                        Style="{StaticResource EditorValidationSummaryStyle}">
                <TextBlock Text="Warnings: " VerticalAlignment="Center" Foreground="#FF805000" />
                <TextBlock Text="{Binding WarningCount}" VerticalAlignment="Center" Foreground="#FF805000" />
                <TextBlock Text="    Errors: " VerticalAlignment="Center" Foreground="#FF8F0000" />
                <TextBlock Text="{Binding ErrorCount}" VerticalAlignment="Center" Foreground="#FF8F0000" />
                <TextBlock Text="Validation issues are advisory; saving is still allowed."
                           Visibility="{Binding HasValidationDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}"
                           VerticalAlignment="Center" Margin="18,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
