<UserControl x:Class="LyricsDisplayer.Views.Main.MainHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:strings="clr-namespace:LyricsDisplayer.Resources"
             Margin="0,0,0,14">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding EffectiveTitle}" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Text="{Binding EffectiveArtist}" FontSize="13" Foreground="#FF6B7280"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasEffectiveArtist, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <Button Content="{x:Static strings:Strings.MainOpenBuiltInEditor}" Command="{Binding SurfaceActions.OpenBuiltInEditor.Command}"
                    Padding="12,7" Margin="0,0,8,0" />
            <Button Content="{x:Static strings:Strings.ShowDesktopLyrics}" Click="OnShowDesktopLyricsClick"
                    Padding="12,7" Margin="0,0,8,0" />
            <Button Content="{x:Static strings:Strings.OpenLrcExternally}" Command="{Binding SurfaceActions.OpenLrcExternally.Command}"
                    ToolTip="{Binding SurfaceActions.ExternalLyricsStatus}" Padding="12,7" />
            <Button Content="{x:Static strings:Strings.Settings}" Command="{Binding SurfaceActions.OpenSettingsCommand}" Padding="12,7" />
        </WrapPanel>
    </Grid>
</UserControl>
