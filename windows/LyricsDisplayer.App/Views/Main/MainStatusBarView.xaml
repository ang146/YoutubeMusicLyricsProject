<UserControl x:Class="LyricsDisplayer.Views.Main.MainStatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0,12,0,0" LastChildFill="True">
        <TextBlock Text="{Binding LyricsStatusText}" DockPanel.Dock="Right"
                   Foreground="#FF6B7280" VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#FF6B7280"
                   VerticalAlignment="Center" />
    </DockPanel>
</UserControl>
