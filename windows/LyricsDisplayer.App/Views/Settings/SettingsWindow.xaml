<Window x:Class="LyricsDisplayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricsDisplayer"
        Title="Settings" Width="860" Height="580" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Topmost="False" ShowInTaskbar="True" ShowActivated="True">
    <Window.Resources>
        <DataTemplate x:Key="GeneralSettingsPageTemplate">
            <local:GeneralSettingsPage />
        </DataTemplate>
        <DataTemplate x:Key="LyricsOverlaySettingsPageTemplate">
            <local:LyricsOverlaySettingsPage />
        </DataTemplate>
        <DataTemplate x:Key="LyricsWindowSettingsPageTemplate">
            <local:LyricsWindowSettingsPage />
        </DataTemplate>
        <DataTemplate x:Key="MediaControllerSettingsPageTemplate">
            <local:MediaControllerSettingsPage />
        </DataTemplate>
        <DataTemplate x:Key="EditorSettingsPageTemplate">
            <local:EditorSettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:SettingsPageViewModel}">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource GeneralSettingsPageTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Id}" Value="{x:Static local:SettingsPageId.LyricsOverlay}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LyricsOverlaySettingsPageTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Id}" Value="{x:Static local:SettingsPageId.LyricsWindow}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LyricsWindowSettingsPageTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Id}" Value="{x:Static local:SettingsPageId.MediaController}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MediaControllerSettingsPageTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Id}" Value="{x:Static local:SettingsPageId.Editor}">
                                <Setter Property="ContentTemplate" Value="{StaticResource EditorSettingsPageTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:DebugSettingsPageViewModel}">
            <local:DebugSettingsPage />
        </DataTemplate>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF374151" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE8EEF5" />
                    <Setter Property="Foreground" Value="#FF202B38" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#FFF8F9FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0" Margin="12" Padding="4"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" FontSize="14" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="1" Margin="8,12,12,12" Background="White"
                BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="6">
            <ContentControl Content="{Binding SelectedPage}" />
        </Border>
    </Grid>
</Window>
